+def _format_time_part(dt: datetime) -> str:
+    """`%-I:%M %p` 小写形式的跨平台写法。"""
+    hour12 = dt.hour % 12 or 12
+    return f"{hour12}:{dt.strftime('%M %p')}".lower()
