+def _format_date_part(dt: datetime) -> str:
+    """`%b %-d, %Y` 的跨平台写法（`%-d` 是 glibc 专有，Windows 不认）。"""
+    return f"{dt.strftime('%b')} {dt.day}, {dt.year}"
+
